{
  "name": "umamusume-pocket-duel",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently \"npm --workspace backend run dev\" \"npm --workspace frontend run dev\"",
    "dev:frontend": "npm --workspace frontend run dev",
    "dev:backend": "npm --workspace backend run dev",
    "build": "npm --workspace backend run build && npm --workspace frontend run build",
    "start": "npm --workspace backend run start",
    "sim:ai": "npm --workspace backend run sim:ai --",
    "sim:export-training": "npm --workspace backend run sim:export-training --",
    "sim:export-outcome-training": "npm --workspace backend run sim:export-outcome-training --",
    "sim:evaluate-model": "npm --workspace backend run sim:evaluate-model --",
    "sim:eval-gate": "npm --workspace backend run sim:eval-gate --",
    "setup:python-train": "python3 -m venv training/.venv && training/.venv/bin/pip install -r training/requirements.txt",
    "setup:python-train:gpu": "python3 -m venv training/.venv && training/.venv/bin/pip install -r training/requirements-gpu.txt",
    "test:train": "npm --workspace backend run test:train",
    "test:python-train": "training/.venv/bin/python training/smoke_e2e.py",
    "test:calibrate-value": "training/.venv/bin/python training/calibrate_smoke.py",
    "test:dagger-orchestrator": "training/.venv/bin/python training/dagger_smoke.py",
    "test:opponent-pool": "training/.venv/bin/python training/opponent_pool_smoke.py",
    "test:ppo-smoke": "training/.venv/bin/python training/ppo_smoke.py",
    "test:f1-hp-sweep": "training/.venv/bin/python training/f1_hp_sweep_smoke.py",
    "test:data-coverage-audit": "training/.venv/bin/python training/data_coverage_audit_smoke.py",
    "test:r16-mcts-embedding": "training/.venv/bin/python training/r16_mcts_embedding_smoke.py",
    "test:pair-builder": "training/.venv/bin/python training/pair_builder_smoke.py",
    "test:pair-corpus": "training/.venv/bin/python training/pair_corpus_smoke.py",
    "test:dpo-quality-eval": "training/.venv/bin/python training/dpo_quality_eval_smoke.py"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
